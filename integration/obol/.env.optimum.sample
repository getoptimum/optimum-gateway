# Add these to your CDVN .env (opt-in Optimum Gateway overlay).
# API key: set via env only (not in app_conf.yml).

GATEWAY_VERSION=v1.1.1
OPT_API_KEY=ogw_live_...

# Append the overlay to COMPOSE_FILE (keep existing files; add :optimum/compose-optimum.yml):
# COMPOSE_FILE=compose-el.yml:compose-cl.yml:compose-vc.yml:compose-mev.yml:docker-compose.yml:optimum/compose-optimum.yml

# Optional port overrides (defaults shown):
# GATEWAY_PORT_LIBP2P=33212
# GATEWAY_PORT_MUMP2P=43213
# GATEWAY_PORT_TELEMETRY=48123
